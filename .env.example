# Proveedor: mock | groq | gemini | anthropic | openai | ollama
LLM_PROVIDER=mock

# Límites de tokens (importantes en planes gratuitos)
# tokens de salida máximos por petición
LLM_MAX_TOKENS=800
# recorte de resultados de tools que se reenvían al LLM
LLM_MAX_OBSERVATION_CHARS=2000
# modelos de razonamiento: none (qwen) | low | medium | high
LLM_REASONING_EFFORT=low

# Conexión a PostgreSQL (modo SQL en vivo)
# filas máximas que se traen de una consulta para entrenar/analizar
SQL_ML_MAX_ROWS=50000
# tiempo máximo por consulta en el servidor
SQL_STATEMENT_TIMEOUT_MS=15000

# --- Gratis ---
# Groq: key gratis sin tarjeta en https://console.groq.com/keys
GROQ_API_KEY=
# o qwen/qwen3.8-27b con LLM_REASONING_EFFORT=none
GROQ_MODEL=openai/gpt-oss-120b

# Gemini: key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Ollama: local, sin key
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# --- De pago ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
